
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0b1020" />

  <title>Stripe Connected Successfully</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <style>
    :root {
      color-scheme: dark;
      --bg: #0b1020;
      --surface: #111a2e;
      --border: rgba(148, 163, 184, 0.16);
      --text: #f8fafc;
      --muted: #9aa9bf;
      --green: #34d399;
      --green-dark: #059669;
      --purple: #a5a0ff;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      font-family: "Inter", sans-serif;
      color: var(--text);
      background:
        radial-gradient(
          ellipse at 50% 0%,
          rgba(79, 70, 229, 0.17),
          transparent 55%
        ),
        var(--bg);
    }

    .success-card {
      width: 100%;
      max-width: 510px;
      padding: 42px;
      text-align: center;
      background: linear-gradient(
        160deg,
        rgba(20, 31, 53, 0.98),
        rgba(14, 22, 39, 0.98)
      );
      border: 1px solid var(--border);
      border-radius: 24px;
      box-shadow: 0 28px 90px rgba(0, 0, 0, 0.3);
      animation: enter 0.5s ease-out;
    }

    .success-icon {
      width: 76px;
      height: 76px;
      margin: 0 auto 22px;
      display: grid;
      place-items: center;
      color: #ffffff;
      background: linear-gradient(145deg, #10b981, #047857);
      border-radius: 22px;
      box-shadow: 0 12px 35px rgba(16, 185, 129, 0.2);
    }

    .success-icon svg {
      width: 38px;
      height: 38px;
      stroke: currentColor;
      stroke-width: 2.5;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .status {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 12px;
      margin-bottom: 18px;
      color: #6ee7b7;
      background: rgba(16, 185, 129, 0.09);
      border: 1px solid rgba(52, 211, 153, 0.2);
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.1px;
      text-transform: uppercase;
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 10px rgba(52, 211, 153, 0.6);
    }

    h1 {
      margin-bottom: 14px;
      font-size: clamp(25px, 5vw, 32px);
      font-weight: 700;
      line-height: 1.25;
      letter-spacing: -1px;
    }

    .description {
      max-width: 390px;
      margin: 0 auto;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.85;
    }

    .divider {
      height: 1px;
      margin: 30px 0;
      border: 0;
      background: var(--border);
    }

    .details {
      display: flex;
      flex-direction: column;
      gap: 20px;
      text-align: left;
    }

    .detail {
      display: flex;
      align-items: flex-start;
      gap: 14px;
    }

    .detail-icon {
      width: 38px;
      height: 38px;
      flex-shrink: 0;
      display: grid;
      place-items: center;
      color: var(--green);
      background: rgba(16, 185, 129, 0.09);
      border: 1px solid rgba(52, 211, 153, 0.13);
      border-radius: 12px;
    }

    .detail-icon svg {
      width: 19px;
      height: 19px;
      stroke: currentColor;
      stroke-width: 1.8;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .detail h2 {
      margin: 2px 0 5px;
      font-size: 13px;
      font-weight: 600;
    }

    .detail p {
      color: var(--muted);
      font-size: 12px;
      line-height: 1.7;
    }

    .home-button {
      width: 100%;
      min-height: 50px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-top: 32px;
      padding: 14px 20px;
      color: #ffffff;
      background: linear-gradient(135deg, #10b981, #059669);
      border: 0;
      border-radius: 12px;
      font-family: inherit;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        filter 0.2s ease;
    }

    .home-button:hover {
      transform: translateY(-2px);
      filter: brightness(1.08);
      box-shadow: 0 10px 25px rgba(16, 185, 129, 0.2);
    }

    .home-button:focus-visible {
      outline: 2px solid #6ee7b7;
      outline-offset: 4px;
    }

    .home-button svg {
      width: 18px;
      height: 18px;
      stroke: currentColor;
      stroke-width: 2;
      fill: none;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .footer {
      margin-top: 28px;
      color: #718096;
      font-size: 11px;
      line-height: 1.8;
    }

    .stripe-brand {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      color: var(--purple);
      font-size: 13px;
      font-weight: 800;
      letter-spacing: -0.4px;
    }

    .footer-lock {
      display: inline-block;
      margin-right: 4px;
      vertical-align: -2px;
    }

    @keyframes enter {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 520px) {
      body {
        padding: 16px;
      }

      .success-card {
        padding: 30px 22px;
        border-radius: 20px;
      }

      .success-icon {
        width: 66px;
        height: 66px;
        border-radius: 19px;
      }

      .divider {
        margin: 24px 0;
      }

      .home-button {
        margin-top: 26px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>

<body>
  <main class="success-card">
    <div class="success-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24">
        <path d="m5 12 4 4L19 6" />
      </svg>
    </div>

    <div class="status">
      <span class="status-dot"></span>
      Successfully connected
    </div>

    <h1>You're all set!</h1>

    <p class="description">
      Your Stripe account has been successfully connected to your
      Revenue Financing dashboard. You're one step closer to managing
      your payouts seamlessly.
    </p>

    <hr class="divider" />

    <section class="details" aria-label="Next steps">
      <div class="detail">
        <div class="detail-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M20 7h-9" />
            <path d="M14 3l-4 4 4 4" />
            <path d="M4 17h9" />
            <path d="m10 13 4 4-4 4" />
          </svg>
        </div>
        <div>
          <h2>Account connected</h2>
          <p>Your Stripe connection has been completed. Return to your application to continue.</p>
        </div>
      </div>

      <div class="detail">
        <div class="detail-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M12 8v4l3 2" />
            <circle cx="12" cy="12" r="9" />
          </svg>
        </div>
        <div>
          <h2>Check your integration status</h2>
          <p>Open your dashboard's Integration tab to check the latest Stripe connection status.</p>
        </div>
      </div>

      <div class="detail">
        <div class="detail-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <rect x="3" y="5" width="18" height="14" rx="3" />
            <path d="M3 10h18" />
            <path d="M7 15h3" />
          </svg>
        </div>
        <div>
          <h2>Manage your payouts</h2>
          <p>Review your payout settings and repayment arrangements from your dashboard.</p>
        </div>
      </div>
    </section>

    <a
      class="home-button"
      href="https://finlara.co.uk"
      aria-label="Return to your website"
    >
      Back to Home
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7 17 17 7" />
        <path d="M7 7h10v10" />
      </svg>
    </a>

    <footer class="footer">
      <div>
        <svg
          class="footer-lock"
          width="12"
          height="12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <rect x="5" y="10" width="14" height="11" rx="2" />
          <path d="M8 10V7a4 4 0 0 1 8 0v3" />
        </svg>
        Secure payment infrastructure by
        <span class="stripe-brand">stripe</span>
      </div>

      <p>
        &copy; <%= new Date().getFullYear() %> Revenue Financing.
        All rights reserved.
      </p>
    </footer>
  </main>
</body>
</html>
